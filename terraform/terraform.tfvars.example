###############################################################################
# 구축 파라미터 (kdt5 계정 / ap-northeast-2)
###############################################################################

region      = "ap-northeast-2"
name_prefix = "petclinic"

# 비용 태그 (설계안 Phase 3)
project     = "petclinic-3tier"
environment = "dev"
owner       = "kdt5"
expires_at  = "2026-11-05"

# 네트워크 (설계안 4.1)
vpc_cidr = "10.20.0.0/16"
azs      = ["ap-northeast-2a", "ap-northeast-2b"]

public_subnet_cidrs   = ["10.20.0.0/24", "10.20.1.0/24"]
ingress_subnet_cidrs  = ["10.20.8.0/24", "10.20.9.0/24"]
workload_subnet_cidrs = ["10.20.32.0/20", "10.20.48.0/20"]
data_subnet_cidrs     = ["10.20.80.0/24", "10.20.81.0/24"]

# 운영형: AZ별 NAT 2개
single_nat_gateway = false

# EKS
cluster_name       = "petclinic-dev"
kubernetes_version = "1.34"
node_instance_type = "m6i.large"

# EKS API endpoint: 설계안 기본은 private.
# 초기 구축/운영 편의를 위해 public 을 켤 경우 반드시 운영자 CIDR 로 제한한다.
cluster_endpoint_public_access       = false
cluster_endpoint_public_access_cidrs = []

# RDS (운영안: Multi-AZ)
db_name                  = "petclinic"
db_master_username       = "petclinicadmin"
db_instance_class        = "db.m6g.large"
db_engine_version        = "8.4.6"
db_allocated_storage     = 100
db_max_allocated_storage = 200
db_multi_az              = true
db_backup_retention_days = 7
db_deletion_protection   = true
db_skip_final_snapshot   = false

# 도메인 / DNS
domain_name          = "mission-critical.site"
app_subdomain        = "clinic"
create_hosted_zone   = true
enable_custom_domain = true

# 예산
budget_limit_usd = 500
budget_alert_emails = [
  # "owner@example.com",
]

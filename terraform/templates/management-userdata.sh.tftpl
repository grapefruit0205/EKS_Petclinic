#!/bin/bash
# 관리 인스턴스 부트스트랩 (Amazon Linux 2023)
# kubectl / helm / mysql client 설치. EKS 접근은 SSM Session Manager 로만 한다.
set -euxo pipefail

REGION="${region}"
CLUSTER_NAME="${cluster_name}"
ECR_REGISTRY="${ecr_registry}"

dnf -y install docker mariadb105 jq tar gzip

systemctl enable --now docker
usermod -aG docker ec2-user

# kubectl
K8S_MINOR=$(aws eks describe-cluster --name "$CLUSTER_NAME" --region "$REGION" \
  --query 'cluster.version' --output text 2>/dev/null || echo "1.34")
curl -sSLo /usr/local/bin/kubectl \
  "https://dl.k8s.io/release/v$K8S_MINOR.0/bin/linux/amd64/kubectl" || \
curl -sSLo /usr/local/bin/kubectl \
  "https://dl.k8s.io/release/$(curl -sL https://dl.k8s.io/release/stable-$K8S_MINOR.txt)/bin/linux/amd64/kubectl"
chmod +x /usr/local/bin/kubectl

# helm
curl -sSL https://get.helm.sh/helm-v3.19.0-linux-amd64.tar.gz -o /tmp/helm.tgz
tar -xzf /tmp/helm.tgz -C /tmp
install -m 0755 /tmp/linux-amd64/helm /usr/local/bin/helm

# kubeconfig (private endpoint 이므로 VPC 내부에서만 동작)
sudo -u ec2-user aws eks update-kubeconfig --name "$CLUSTER_NAME" --region "$REGION" || true

echo "ECR_REGISTRY=$ECR_REGISTRY" > /etc/petclinic.env
echo "bootstrap done" > /var/log/petclinic-bootstrap.log
